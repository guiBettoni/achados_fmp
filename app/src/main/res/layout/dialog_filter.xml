<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/fluent_surface">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Top Header with Close (Tela 5) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="sans-serif-medium"
                android:text="Filtrar achados"
                android:textColor="@color/fluent_text_primary"
                android:textSize="18sp"
                android:textStyle="bold" />

            <ImageView
                android:id="@+id/btnFilterClose"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Fechar"
                android:padding="4dp"
                android:src="@drawable/ic_close"
                app:tint="@color/fluent_text_secondary" />
        </LinearLayout>

        <!-- Category Section (Tela 5) -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:fontFamily="sans-serif-medium"
            android:text="Categoria"
            android:textColor="@color/fluent_text_primary"
            android:textSize="14sp"
            android:textStyle="bold" />

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/chipGroupFilterCategory"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            app:singleSelection="true">

            <com.google.android.material.chip.Chip
                android:id="@+id/filterCatAll"
                style="@style/Widget.Fluent.Chip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="true"
                android:text="Todas" />

            <com.google.android.material.chip.Chip
                android:id="@+id/filterCatKeys"
                style="@style/Widget.Fluent.Chip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Chaves" />

            <com.google.android.material.chip.Chip
                android:id="@+id/filterCatDocs"
                style="@style/Widget.Fluent.Chip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Documentos" />

            <com.google.android.material.chip.Chip
                android:id="@+id/filterCatElec"
                style="@style/Widget.Fluent.Chip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Eletrônicos" />

            <com.google.android.material.chip.Chip
                android:id="@+id/filterCatAccessories"
                style="@style/Widget.Fluent.Chip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Acessórios" />

            <com.google.android.material.chip.Chip
                android:id="@+id/filterCatClothes"
                style="@style/Widget.Fluent.Chip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Roupas" />

            <com.google.android.material.chip.Chip
                android:id="@+id/filterCatBooks"
                style="@style/Widget.Fluent.Chip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Livros" />

            <com.google.android.material.chip.Chip
                android:id="@+id/filterCatOther"
                style="@style/Widget.Fluent.Chip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Outros" />
        </com.google.android.material.chip.ChipGroup>

        <!-- Status Section (Tela 5) -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:fontFamily="sans-serif-medium"
            android:text="Status"
            android:textColor="@color/fluent_text_primary"
            android:textSize="14sp"
            android:textStyle="bold" />

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/chipGroupFilterStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            app:singleSelection="true">

            <com.google.android.material.chip.Chip
                android:id="@+id/filterStatusAll"
                style="@style/Widget.Fluent.Chip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="true"
                android:text="Todos" />

            <com.google.android.material.chip.Chip
                android:id="@+id/filterStatusWaiting"
                style="@style/Widget.Fluent.Chip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Aguardando o dono" />

            <com.google.android.material.chip.Chip
                android:id="@+id/filterStatusDelivered"
                style="@style/Widget.Fluent.Chip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Devolvido" />
        </com.google.android.material.chip.ChipGroup>

        <!-- Período Section (Tela 5) -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:fontFamily="sans-serif-medium"
            android:text="Período"
            android:textColor="@color/fluent_text_primary"
            android:textSize="14sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:baselineAligned="false"
            android:orientation="horizontal">

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilStartDate"
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:hint="Data inicial"
                app:boxCornerRadiusBottomEnd="8dp"
                app:boxCornerRadiusBottomStart="8dp"
                app:boxCornerRadiusTopEnd="8dp"
                app:boxCornerRadiusTopStart="8dp"
                app:endIconDrawable="@drawable/ic_calendar"
                app:endIconMode="custom">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etFilterStartDate"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:focusable="false"
                    android:inputType="none"
                    android:textSize="13sp" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilEndDate"
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:hint="Data final"
                app:boxCornerRadiusBottomEnd="8dp"
                app:boxCornerRadiusBottomStart="8dp"
                app:boxCornerRadiusTopEnd="8dp"
                app:boxCornerRadiusTopStart="8dp"
                app:endIconDrawable="@drawable/ic_calendar"
                app:endIconMode="custom">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etFilterEndDate"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:focusable="false"
                    android:inputType="none"
                    android:textSize="13sp" />
            </com.google.android.material.textfield.TextInputLayout>
        </LinearLayout>

        <!-- Bottom Action Buttons (Tela 5) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnDialogClearFilter"
                style="@style/Widget.Fluent.Button.Secondary"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:text="Limpar filtros" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnDialogApplyFilter"
                style="@style/Widget.Fluent.Button.Primary"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:text="Aplicar filtros" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>
