<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fluent_background"
    android:orientation="vertical">

    <!-- Top Header Area (Matching Tela 4) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/fluent_surface"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="12dp"
        android:paddingEnd="16dp"
        android:paddingBottom="12dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/btnAllItemsBack"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Voltar para o Início"
                android:padding="2dp"
                android:src="@drawable/ic_arrow_back"
                app:tint="@color/fluent_text_primary" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:text="Todos os achados"
                    android:textColor="@color/fluent_text_primary"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Veja todos os objetos registrados na FMP"
                    android:textColor="@color/fluent_text_secondary"
                    android:textSize="12sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Search Bar with Filter Button (Tela 4) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="46dp"
                android:layout_weight="1"
                android:background="@drawable/bg_fluent_search"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="12dp"
                android:paddingEnd="12dp">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_search" />

                <EditText
                    android:id="@+id/etAllItemsSearch"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_marginStart="8dp"
                    android:background="@null"
                    android:hint="Buscar objeto..."
                    android:imeOptions="actionSearch"
                    android:inputType="text"
                    android:textColor="@color/fluent_text_primary"
                    android:textColorHint="@color/fluent_text_tertiary"
                    android:textSize="14sp" />
            </LinearLayout>

            <!-- Filter Icon Button -->
            <FrameLayout
                android:id="@+id/btnOpenFilter"
                android:layout_width="46dp"
                android:layout_height="46dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_fluent_search"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground">

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_gravity="center"
                    android:contentDescription="Filtrar"
                    android:src="@drawable/ic_filter"
                    app:tint="@color/fluent_blue_primary" />
            </FrameLayout>
        </LinearLayout>

        <!-- Category Pills (Tela 4) -->
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:clipToPadding="false"
            android:scrollbars="none">

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/chipGroupAllCategories"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:singleLine="true"
                app:singleSelection="true">

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipAllCatAll"
                    style="@style/Widget.Fluent.Chip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="true"
                    android:text="Todos" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipAllCatKeys"
                    style="@style/Widget.Fluent.Chip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Chaves" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipAllCatDocs"
                    style="@style/Widget.Fluent.Chip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Documentos" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipAllCatElec"
                    style="@style/Widget.Fluent.Chip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Eletrônicos" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipAllCatAccessories"
                    style="@style/Widget.Fluent.Chip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Acessórios" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipAllCatClothes"
                    style="@style/Widget.Fluent.Chip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Roupas" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipAllCatBooks"
                    style="@style/Widget.Fluent.Chip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Livros" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipAllCatOther"
                    style="@style/Widget.Fluent.Chip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Outros" />
            </com.google.android.material.chip.ChipGroup>
        </HorizontalScrollView>
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/fluent_divider" />

    <!-- Active Filter Indicator -->
    <LinearLayout
        android:id="@+id/layoutActiveFilterBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/fluent_surface_variant"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingTop="6dp"
        android:paddingEnd="16dp"
        android:paddingBottom="6dp">

        <TextView
            android:id="@+id/tvActiveFilterDesc"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="@color/fluent_text_secondary"
            android:textSize="12sp"
            tools:text="Exibindo todos os objetos (7 itens)" />

        <TextView
            android:id="@+id/tvClearFilter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-medium"
            android:padding="4dp"
            android:text="Limpar filtros"
            android:textColor="@color/fluent_blue_primary"
            android:textSize="12sp"
            android:visibility="gone"
            tools:visibility="visible" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:paddingBottom="74dp">

        <!-- All Items List -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvAllItems"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingTop="6dp"
            android:paddingBottom="16dp"
            tools:listitem="@layout/item_card_fluent" />

        <!-- Empty State -->
        <LinearLayout
            android:id="@+id/layoutEmptyAllItems"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="32dp"
            android:visibility="gone"
            tools:visibility="gone">

            <ImageView
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_empty_box" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:fontFamily="sans-serif-medium"
                android:text="Nenhum objeto encontrado"
                android:textColor="@color/fluent_text_primary"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="center"
                android:text="Tente alterar os termos da busca ou limpar os filtros aplicados."
                android:textColor="@color/fluent_text_secondary"
                android:textSize="13sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnEmptyResetFilters"
                style="@style/Widget.Fluent.Button.Secondary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Limpar filtros" />
        </LinearLayout>
    </FrameLayout>

</LinearLayout>
