<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fluent_background">

    <!-- Top Toolbar Header (Tela 3 & 4) -->
    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="@color/fluent_surface"
        android:elevation="2dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:contentDescription="@string/app_name"
            android:src="@drawable/ic_fmp_logo" />

        <TextView
            android:id="@+id/tvToolbarTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:fontFamily="sans-serif-medium"
            android:text="Achados da FMP"
            android:textColor="@color/fluent_blue_primary"
            android:textSize="18sp"
            android:textStyle="bold" />

        <!-- Theme Toggle Button (Moon/Sun icon in mockup) -->
        <FrameLayout
            android:id="@+id/btnToggleThemeTop"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:id="@+id/ivThemeToggleIcon"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_gravity="center"
                android:contentDescription="Alternar tema claro e escuro"
                android:src="@drawable/ic_moon"
                app:tint="@color/fluent_text_secondary" />
        </FrameLayout>
    </LinearLayout>

    <View
        android:id="@+id/topDivider"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/fluent_divider"
        app:layout_constraintTop_toBottomOf="@+id/topBar" />

    <!-- ViewFlipper Container for the Screens -->
    <ViewFlipper
        android:id="@+id/viewFlipper"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@+id/bottomNavContainer"
        app:layout_constraintTop_toBottomOf="@+id/topDivider">

        <!-- 0: Home (Tela 3) -->
        <include
            android:id="@+id/tabHome"
            layout="@layout/layout_tab_home" />

        <!-- 1: Todos os Achados (Tela 4) -->
        <include
            android:id="@+id/tabAllItems"
            layout="@layout/layout_tab_all_items" />

        <!-- 2: Cadastrar Ocorrência (Tela 7, 8, 9) -->
        <include
            android:id="@+id/tabRegister"
            layout="@layout/layout_tab_register" />

        <!-- 3: Meus Registros (Tela 11) -->
        <include
            android:id="@+id/tabMyItems"
            layout="@layout/layout_tab_my_items" />

        <!-- 4: Meu Perfil (Tela 10) -->
        <include
            android:id="@+id/tabProfile"
            layout="@layout/layout_tab_profile" />

        <!-- 5: Configurações (Tela 12) -->
        <include
            android:id="@+id/tabSettings"
            layout="@layout/layout_tab_settings" />

    </ViewFlipper>

    <!-- Bottom Navigation Bar Matching Mockup (Tela 3, 4, 7, 10, 11, 12) -->
    <FrameLayout
        android:id="@+id/bottomNavContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent">

        <include
            android:id="@+id/mockupBottomNav"
            layout="@layout/layout_bottom_nav_mockup" />
    </FrameLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
