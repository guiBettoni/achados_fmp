<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fluent_background">

    <!-- Top AppBar (Tela 6) -->
    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/fluent_surface"
        app:elevation="2dp">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/detailToolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            app:navigationIcon="@drawable/ic_arrow_back"
            app:navigationIconTint="@color/fluent_text_primary"
            app:title="Detalhes do objeto"
            app:titleTextColor="@color/fluent_text_primary" />
    </com.google.android.material.appbar.AppBarLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="40dp">

            <!-- Large Photo Preview Card (Tela 6) -->
            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.Fluent.Card"
                android:layout_width="match_parent"
                android:layout_height="240dp"
                android:layout_marginStart="16dp"
                android:layout_marginTop="16dp"
                android:layout_marginEnd="16dp"
                app:cardCornerRadius="16dp"
                app:strokeColor="@color/fluent_divider"
                app:strokeWidth="1dp">

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">

                    <com.google.android.material.imageview.ShapeableImageView
                        android:id="@+id/ivDetailPhoto"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@color/fluent_surface_variant"
                        android:contentDescription="Foto do objeto"
                        android:scaleType="centerCrop"
                        android:src="@drawable/thumb_earbuds" />

                    <!-- Carousel Dots (Tela 6) -->
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="bottom|center_horizontal"
                        android:layout_marginBottom="12dp"
                        android:gravity="center"
                        android:orientation="horizontal">

                        <View
                            android:layout_width="8dp"
                            android:layout_height="8dp"
                            android:background="@drawable/bg_badge_pickup" />

                        <View
                            android:layout_width="6dp"
                            android:layout_height="6dp"
                            android:layout_marginStart="4dp"
                            android:background="@drawable/bg_item_icon_circle" />

                        <View
                            android:layout_width="6dp"
                            android:layout_height="6dp"
                            android:layout_marginStart="4dp"
                            android:background="@drawable/bg_item_icon_circle" />
                    </LinearLayout>
                </FrameLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Details Card (Tela 6) -->
            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.Fluent.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginTop="12dp"
                android:layout_marginEnd="16dp"
                app:cardCornerRadius="14dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <!-- Category Pill -->
                    <TextView
                        android:id="@+id/tvDetailCategoryPill"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_badge_pickup"
                        android:fontFamily="sans-serif-medium"
                        android:textColor="@color/fluent_blue_primary"
                        android:textSize="12sp"
                        tools:text="Eletrônicos" />

                    <!-- Title -->
                    <TextView
                        android:id="@+id/tvDetailTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:fontFamily="sans-serif-medium"
                        android:textColor="@color/fluent_text_primary"
                        android:textSize="20sp"
                        android:textStyle="bold"
                        tools:text="Fone de ouvido" />

                    <!-- Info items with icons (Tela 6) -->
                    <!-- Date -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_calendar"
                            app:tint="@color/fluent_text_secondary" />

                        <TextView
                            android:id="@+id/tvDetailDate"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:textColor="@color/fluent_text_secondary"
                            android:textSize="13sp"
                            tools:text="11/09/2026" />
                    </LinearLayout>

                    <!-- Location -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_location"
                            app:tint="@color/fluent_text_secondary" />

                        <TextView
                            android:id="@+id/tvDetailLocation"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:textColor="@color/fluent_text_secondary"
                            android:textSize="13sp"
                            tools:text="Laboratório 4" />
                    </LinearLayout>

                    <!-- Holding Office -->
                    <LinearLayout
                        android:id="@+id/layoutDetailHoldingLocation"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_building"
                            app:tint="@color/fluent_text_secondary" />

                        <TextView
                            android:id="@+id/tvDetailHoldingLocation"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:textColor="@color/fluent_text_secondary"
                            android:textSize="13sp"
                            tools:text="Secretaria" />
                    </LinearLayout>

                    <!-- Status with Clock -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:id="@+id/ivDetailStatusIcon"
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_clock"
                            app:tint="@color/fluent_blue_primary" />

                        <TextView
                            android:id="@+id/tvDetailStatus"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:fontFamily="sans-serif-medium"
                            android:textColor="@color/fluent_blue_primary"
                            android:textSize="13sp"
                            tools:text="Aguardando retirada" />
                    </LinearLayout>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Section: Descrição (Tela 6) -->
            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.Fluent.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginTop="10dp"
                android:layout_marginEnd="16dp"
                app:cardCornerRadius="14dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-medium"
                        android:text="Descrição"
                        android:textColor="@color/fluent_text_primary"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvDetailDescription"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:lineSpacingExtra="3dp"
                        android:textColor="@color/fluent_text_secondary"
                        android:textSize="13sp"
                        tools:text="Fone de ouvido Sony preto" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Section: Observações (Tela 6) -->
            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.Fluent.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginTop="10dp"
                android:layout_marginEnd="16dp"
                app:cardCornerRadius="14dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-medium"
                        android:text="Observações"
                        android:textColor="@color/fluent_text_primary"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvDetailObservations"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:lineSpacingExtra="3dp"
                        android:textColor="@color/fluent_text_secondary"
                        android:textSize="13sp"
                        tools:text="Encontrado próximo às mesas do laboratório." />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Section: Smart Match Correspondência (Se aplicável) -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardDetailSmartMatch"
                style="@style/Widget.Fluent.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginTop="10dp"
                android:layout_marginEnd="16dp"
                android:visibility="gone"
                app:cardCornerRadius="14dp"
                app:strokeColor="@color/fluent_blue_primary"
                app:strokeWidth="1.5dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="14dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_sparkles"
                            app:tint="@color/fluent_blue_primary" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:layout_weight="1"
                            android:fontFamily="sans-serif-medium"
                            android:text="Correspondência Inteligente Encontrada!"
                            android:textColor="@color/fluent_blue_primary"
                            android:textSize="14sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvDetailSmartMatchText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="Um item similar foi guardado na Secretaria. Toque no botão abaixo para abrir os detalhes."
                        android:textColor="@color/fluent_text_secondary"
                        android:textSize="12sp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnOpenDetailMatch"
                        style="@style/Widget.Fluent.Button.Secondary"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="Visualizar item correspondente" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Section: Código do registro Institucional -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardProtocolCode"
                style="@style/Widget.Fluent.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginTop="10dp"
                android:layout_marginEnd="16dp"
                app:cardCornerRadius="14dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:fontFamily="sans-serif-medium"
                            android:text="Código do registro"
                            android:textColor="@color/fluent_text_primary"
                            android:textSize="15sp"
                            android:textStyle="bold" />

                        <!-- Protocol Pill with Copy Button -->
                        <LinearLayout
                            android:id="@+id/btnCopyProtocol"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:minHeight="48dp"
                            android:background="@drawable/bg_badge_pickup"
                            android:clickable="true"
                            android:focusable="true"
                            android:foreground="?attr/selectableItemBackground"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:paddingStart="8dp"
                            android:paddingTop="4dp"
                            android:paddingEnd="8dp"
                            android:paddingBottom="4dp">

                            <TextView
                                android:id="@+id/tvProtocolCode"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="sans-serif-medium"
                                android:textColor="@color/fluent_blue_primary"
                                android:textSize="12sp"
                                android:textStyle="bold"
                                tools:text="FMP-RET-4182" />

                            <ImageView
                                android:layout_width="14dp"
                                android:layout_height="14dp"
                                android:layout_marginStart="4dp"
                                android:contentDescription="Copiar código"
                                android:src="@drawable/ic_copy"
                                app:tint="@color/fluent_blue_primary" />
                        </LinearLayout>
                    </LinearLayout>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:fontFamily="sans-serif"
                        android:text="Informe este código na Secretaria para localizar o registro mais rápido."
                        android:textColor="@color/fluent_text_secondary"
                        android:textSize="12sp" />

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Section: Linha do Tempo / Histórico de Custódia -->
            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.Fluent.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginTop="10dp"
                android:layout_marginEnd="16dp"
                app:cardCornerRadius="14dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-medium"
                        android:text="Linha do Tempo do Objeto"
                        android:textColor="@color/fluent_text_primary"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <!-- Step 1: Registro Efetuado -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:layout_width="24dp"
                            android:layout_height="match_parent"
                            android:gravity="center_horizontal"
                            android:orientation="vertical">

                            <ImageView
                                android:layout_width="18dp"
                                android:layout_height="18dp"
                                android:background="@drawable/bg_item_icon_circle"
                                android:contentDescription="@null"
                                android:padding="3dp"
                                android:src="@drawable/ic_check"
                                app:tint="@color/fluent_status_delivered_text" />

                            <View
                                android:layout_width="2dp"
                                android:layout_height="24dp"
                                android:background="@color/fluent_divider" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="sans-serif-medium"
                                android:text="1. Ocorrência cadastrada no sistema"
                                android:textColor="@color/fluent_text_primary"
                                android:textSize="13sp" />

                            <TextView
                                android:id="@+id/tvTimelineStep1Date"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textColor="@color/fluent_text_secondary"
                                android:textSize="11sp"
                                tools:text="Registrado na data informada" />
                        </LinearLayout>
                    </LinearLayout>

                    <!-- Step 2: Em Custódia / Triagem -->
                    <LinearLayout
                        android:id="@+id/layoutTimelineStep2"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:layout_width="24dp"
                            android:layout_height="match_parent"
                            android:gravity="center_horizontal"
                            android:orientation="vertical">

                            <ImageView
                                android:id="@+id/ivTimelineStep2Icon"
                                android:layout_width="18dp"
                                android:layout_height="18dp"
                                android:background="@drawable/bg_item_icon_circle"
                                android:contentDescription="@null"
                                android:padding="3dp"
                                android:src="@drawable/ic_check"
                                app:tint="@color/fluent_blue_primary" />

                            <View
                                android:id="@+id/vTimelineStep2Line"
                                android:layout_width="2dp"
                                android:layout_height="24dp"
                                android:background="@color/fluent_divider" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/tvTimelineStep2Title"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="sans-serif-medium"
                                android:text="2. Triagem e guarda na Secretaria"
                                android:textColor="@color/fluent_text_primary"
                                android:textSize="13sp" />

                            <TextView
                                android:id="@+id/tvTimelineStep2Sub"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="[PREENCHER: local da Secretaria]"
                                android:textColor="@color/fluent_text_secondary"
                                android:textSize="11sp" />
                        </LinearLayout>
                    </LinearLayout>

                    <!-- Step 3: Aguardando Retirada -->
                    <LinearLayout
                        android:id="@+id/layoutTimelineStep3"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:layout_width="24dp"
                            android:layout_height="match_parent"
                            android:gravity="center_horizontal"
                            android:orientation="vertical">

                            <ImageView
                                android:id="@+id/ivTimelineStep3Icon"
                                android:layout_width="18dp"
                                android:layout_height="18dp"
                                android:background="@drawable/bg_item_icon_circle"
                                android:contentDescription="@null"
                                android:padding="3dp"
                                android:src="@drawable/ic_clock"
                                app:tint="@color/fluent_blue_primary" />

                            <View
                                android:layout_width="2dp"
                                android:layout_height="24dp"
                                android:background="@color/fluent_divider" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="sans-serif-medium"
                                android:text="3. Disponível para retirada pelo titular"
                                android:textColor="@color/fluent_text_primary"
                                android:textSize="13sp" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Comparecer com carteirinha estudantil ou RG"
                                android:textColor="@color/fluent_text_secondary"
                                android:textSize="11sp" />
                        </LinearLayout>
                    </LinearLayout>

                    <!-- Step 4: Devolvido / Concluído -->
                    <LinearLayout
                        android:id="@+id/layoutTimelineStep4"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <ImageView
                            android:id="@+id/ivTimelineStep4Icon"
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:layout_gravity="top"
                            android:background="@drawable/bg_item_icon_circle"
                            android:contentDescription="@null"
                            android:padding="3dp"
                            android:src="@drawable/ic_check"
                            app:tint="@color/fluent_text_tertiary" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="14dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/tvTimelineStep4Title"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="sans-serif-medium"
                                android:text="4. Devolvido com sucesso ao titular"
                                android:textColor="@color/fluent_text_secondary"
                                android:textSize="13sp" />

                            <TextView
                                android:id="@+id/tvTimelineStep4Sub"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Termo de entrega assinado na Secretaria Acadêmica"
                                android:textColor="@color/fluent_text_tertiary"
                                android:textSize="11sp" />
                        </LinearLayout>
                    </LinearLayout>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Action Buttons -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginTop="16dp"
                android:layout_marginEnd="16dp"
                android:orientation="vertical">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnHowToClaim"
                    style="@style/Widget.Fluent.Button.Primary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Como resgatar na Secretaria" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnToggleDelivered"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Marcar como devolvido"
                    android:textColor="@color/fluent_text_secondary" />
            </LinearLayout>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
