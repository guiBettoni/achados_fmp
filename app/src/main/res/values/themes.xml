<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme with Microsoft Fluent Design inspiration -->
    <style name="Theme.AchadosFMP" parent="Theme.Material3.Light.NoActionBar">
        <!-- Fluent Primary Brand Colors -->
        <item name="colorPrimary">@color/fluent_blue_primary</item>
        <item name="colorOnPrimary">@color/fluent_text_white</item>
        <item name="colorPrimaryContainer">@color/fluent_blue_tint</item>
        <item name="colorOnPrimaryContainer">@color/fluent_blue_dark</item>

        <!-- Background & Surface -->
        <item name="android:windowBackground">@color/fluent_background</item>
        <item name="colorSurface">@color/fluent_surface</item>
        <item name="colorOnSurface">@color/fluent_text_primary</item>
        <item name="colorSurfaceVariant">@color/fluent_surface_variant</item>
        <item name="colorOnSurfaceVariant">@color/fluent_text_secondary</item>

        <!-- Status & Navigation Bar (Fluent Crisp Clean Surface) -->
        <item name="android:statusBarColor">@color/fluent_surface</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:navigationBarColor">@color/fluent_surface</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="o_mr1">true</item>

        <!-- Typography -->
        <item name="android:textColorPrimary">@color/fluent_text_primary</item>
        <item name="android:textColorSecondary">@color/fluent_text_secondary</item>
    </style>

    <!-- Splash Screen Theme -->
    <style name="Theme.AchadosFMP.Splash" parent="Theme.AchadosFMP">
        <item name="android:windowBackground">@color/fluent_surface</item>
        <item name="android:statusBarColor">@color/fluent_surface</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>

    <!-- Card Fluent Style -->
    <style name="Widget.Fluent.Card" parent="Widget.Material3.CardView.Elevated">
        <item name="cardCornerRadius">10dp</item>
        <item name="cardElevation">2dp</item>
        <item name="cardBackgroundColor">@color/fluent_surface</item>
        <item name="strokeColor">@color/fluent_divider</item>
        <item name="strokeWidth">1dp</item>
    </style>

    <!-- Button Fluent Styles -->
    <style name="Widget.Fluent.Button.Primary" parent="Widget.Material3.Button">
        <item name="backgroundTint">@color/fluent_blue_primary</item>
        <item name="android:textColor">@color/fluent_text_white</item>
        <item name="cornerRadius">8dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:minHeight">48dp</item>
    </style>

    <style name="Widget.Fluent.Button.Secondary" parent="Widget.Material3.Button.OutlinedButton">
        <item name="strokeColor">@color/fluent_border</item>
        <item name="strokeWidth">1dp</item>
        <item name="android:textColor">@color/fluent_blue_primary</item>
        <item name="cornerRadius">8dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">14sp</item>
        <item name="android:minHeight">48dp</item>
    </style>

    <!-- Subdued Tag/Badge Style -->
    <style name="Widget.Fluent.Chip" parent="Widget.Material3.Chip.Filter">
        <item name="chipCornerRadius">8dp</item>
        <item name="chipStrokeWidth">1dp</item>
        <item name="chipStrokeColor">@color/fluent_divider</item>
        <item name="chipBackgroundColor">@color/fluent_surface</item>
    </style>
</resources>
